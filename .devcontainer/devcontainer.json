// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go
{
  "name": "Awesome AI",
  "image": "python:3.12-bullseye",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/zsh",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black"
      },
      "extensions": [
        "ms-python.python",          // Python 基础扩展
        "ms-python.vscode-pylance",  // 类型检查
        "charliermarsh.ruff",        // 高性能 Linter
        "formulahendry.code-runner" // 代码运行器
      ]
    }
  },
  "forwardPorts": [
    5050  // 按需添加应用端口（如 Flask/Gunicorn）
  ],
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postStartCommand": "echo 'Hello, AI!'",
  "remoteUser": "devuser",
  "updateRemoteUserUID": true,
   "mounts": [
		"source=${localEnv:HOME}/.gitignore,target=/home/devuser/.gitignore,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.netrc,target=/home/devuser/.netrc,type=bind,consistency=cached",
	],
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"installOhMyZsh": true,
			"installOhMyZshConfig": true,
			"upgradePackages": true,
			// "installNode": true,
			// "username": "devuser",
			// "userUid": "1000",
			// "userGid": "1000"
		}
	},
  "containerEnv": {},
}
